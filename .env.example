# Copy this file to .env and fill in real values. Never commit .env.

# --- RingCentral ---
RC_MODE=manual                 # "api-v2" (User Call Handling v2), "api" (legacy answering-rule), or "manual"
                               # Check which backend the account is on:
                               #   GET /restapi/v1.0/account/~/extension/~/features?featureId=NewCallHandlingAndForwarding
                               # isNewBackendAvailable=true -> you must use api-v2.
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_SERVER_URL=https://platform.ringcentral.com
RC_JWT=                        # RingCentral JWT auth token for the automation app
RC_MAIN_EXTENSION_ID=          # Extension ID for the Sacramental Emergency Line (Ext. 1)
RC_ANSWERING_RULE_ID=          # legacy RC_MODE=api only: ID of the "My Work Day" answering rule
RC_STATE_RULE_ID=work-hours    # RC_MODE=api-v2 only: state rule to reorder (business hours)

# --- Signal (via signal-cli) ---
SIGNAL_CLI_PATH=/usr/local/bin/signal-cli
SIGNAL_BOT_NUMBER=             # the dedicated Google Voice number registered to signal-cli
SIGNAL_POLL_INTERVAL_SECONDS=10

# --- Email fallback (used only if a Signal send fails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=                # comma-separated list, e.g. admin@parish.org,pastor@parish.org

# --- Web dashboard ---
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=changeme
FLASK_SECRET_KEY=changeme-generate-a-real-random-value

# --- Call rotation threshold ---
ROTATION_CALL_THRESHOLD=15     # rotate automatically after this many calls to the lead priest

# --- Host networking ---
# This machine's Tailscale IP (`tailscale ip -4`). Used by docker-compose.yml
# to bind the dashboard port to Tailscale only, not the public internet.
# MUST be updated to the new host's Tailscale IP when moving this project to
# a different machine, or `docker compose up` will fail to bind the port.
TAILSCALE_IP=
